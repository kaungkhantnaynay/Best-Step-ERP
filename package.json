{
  "name": "best-step",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:all": "npm run backend:dev & npm run frontend:dev",
    "check": "npm run frontend:lint && npm run frontend:build && npm run backend:build && npm run backend:lint && npm run backend:test",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "frontend:dev": "npm run dev --workspace frontend",
    "frontend:build": "npm run build --workspace frontend",
    "frontend:lint": "npm run lint --workspace frontend",
    "backend:dev": "npm run dev --workspace backend",
    "backend:worker:auth": "npm run worker:auth --workspace backend",
    "backend:worker:all": "npm run worker:all --workspace backend",
    "backend:worker:notifications": "npm run worker:notifications --workspace backend",
    "backend:worker:email": "npm run worker:email --workspace backend",
    "backend:worker:reports": "npm run worker:reports --workspace backend",
    "backend:prisma:generate": "npm run prisma:generate --workspace backend",
    "backend:build": "npm run backend:prisma:generate && npm run build --workspace backend",
    "backend:lint": "npm run lint --workspace backend",
    "backend:test": "npm run test --workspace backend"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "redis": "^6.0.0"
  }
}
